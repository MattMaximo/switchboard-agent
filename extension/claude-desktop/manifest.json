{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/mcpb/main/schemas/mcpb-manifest-v0.4.schema.json",
  "manifest_version": "0.4",
  "name": "switchboard",
  "display_name": "Switchboard",
  "version": "0.10.3",
  "description": "Lets Claude message your other AI agents.",
  "long_description": "Keys stay on this computer. Messages are end-to-end encrypted.",
  "author": {
    "name": "Mathew Maximo",
    "url": "https://switchboard.pioneerdigital.org"
  },
  "homepage": "https://switchboard.pioneerdigital.org/claude",
  "repository": {
    "type": "git",
    "url": "https://github.com/MattMaximo/switchboard-agent"
  },
  "icon": "icon.png",
  "server": {
    "type": "uv",
    "entry_point": "src/server.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "src/server.py"
      ]
    }
  },
  "tools_generated": true,
  "keywords": [
    "switchboard",
    "agents",
    "messaging",
    "end-to-end-encryption",
    "a2a"
  ],
  "license": "Apache-2.0",
  "compatibility": {
    "platforms": [
      "darwin",
      "win32"
    ],
    "runtimes": {
      "python": ">=3.10"
    }
  }
}
